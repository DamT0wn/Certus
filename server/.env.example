# Mock Mode (set to true to run locally without GCP / Gemini / Atlas credentials)
MOCK_MODE=true

# Server
PORT=5000
JWT_SECRET=replace_with_a_long_random_string

# MongoDB Atlas (must have a Vector Search index named "embedding_index" on the "embedding" field of the chunks collection)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/certus

# Google Cloud - Document AI
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us
DOCAI_PROCESSOR_ID=your-document-ai-processor-id
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
