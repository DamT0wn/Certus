# Mock Mode (set to true to run locally without GCP / Gemini / Atlas credentials)
MOCK_MODE=

# Server
PORT=
# MongoDB Atlas (must have a Vector Search index named "embedding_index" on the "embedding" field of the chunks collection)
MONGODB_URI=

# Google Cloud - Document AI
GCP_PROJECT_ID=
GCP_LOCATION=
DOCAI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=
EMBEDDING_MODEL=
# Optional matcher thresholds; defaults 0.85 and 0.25.
VERIFY_CONTAINMENT_THRESHOLD=
VERIFY_LEXICAL_THRESHOLD=

# Optional live US case-law research; independent of MOCK_MODE.
COURTLISTENER_API_TOKEN=
